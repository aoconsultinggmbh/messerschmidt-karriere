# Karriereseite – Regeln für All-Inkl. Die Übergangsadresse (kasserver.com) bleibt immer erreichbar.
RewriteEngine On
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# http → https, mit www → ohne www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.zahnzentrum-messerschmidt-karriere\.de$ [NC]
RewriteRule ^ https://zahnzentrum-messerschmidt-karriere.de%{REQUEST_URI} [L,R=301,NE]

# Konfiguration nie ausliefern
<Files "bewerbung-konfiguration.php">
  Require all denied
</Files>

# Zwischenspeicher: HTML nie, CSS/JS einen Tag, Bilder ein Jahr
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Keine Weiterleitungen nötig: Die Karriereseite ist neu, es gibt keine alten Adressen unter dieser Domain.
# Die Hauptseite verlinkt im Menü und im Karriere-Abschnitt hierher.

ErrorDocument 404 /404.html
